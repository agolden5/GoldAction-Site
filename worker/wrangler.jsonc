{
  "name": "goldaction-playground",
  "main": "index.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGIN": "https://goldaction.net",
    "LIVE_ENABLED": "false"
  },
  "durable_objects": {
    "bindings": [{ "name": "BUDGET", "class_name": "PlaygroundBudget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlaygroundBudget"] }]
}
